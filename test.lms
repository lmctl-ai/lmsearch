# Comprehensive integration test for lmsearch (ONNX + FAISS + AutoFaiss + lmcode SAM rules)

program = _lmcode_ schema="schema/lmsearch.dsl.json";

@embed
fn scale_and_norm(vec: FloatList, dim: int) -> FloatList implements EmbeddingTransform {
    let out = float_list();
    let i = 0;
    while (i < dim) {
        if (i == 0) {
            out.add(vec.at(i) * 1.25);
        } else {
            out.add(vec.at(i));
        }
        i = i + 1;
    }
    return l2_normalize(out);
}

@policy
fn require_compression(plan: AutoPlan) -> string implements IndexPolicy {
    let chosen = plan.index_key();
    if (plan.compression_ratio() < 1.2) {
        chosen = "IVF64,PQ4x8";
    }
    return chosen;
}

@filter
fn active_docs_only(id: int, d: Document) -> bool implements VectorFilter {
    let keep = false;
    if (id > 0 && d.has("status") && d.get("status") == "active") {
        keep = true;
    }
    return keep;
}

@rerank
fn priority_reranker(hit: SearchHit, query: string) -> float implements Reranker {
    let s = hit.score();
    let d = hit.document();
    if (d.has("priority") && str_contains(query, "faiss")) {
        s = s + float(d.get_number("priority")) * 0.05;
    }
    return s;
}

@audit
fn audit_metrics(m: IndexMetrics) -> void implements AuditRule {
    assert_true(m.recall_1_at_k() >= 0.5, "audit: recall_1_at_k must be >= 0.5");
    assert_true(m.size_bytes() > 0, "audit: size_bytes must be positive");
    report("audited_index_params", m.param_string());
}

@ignore
fn prune_noise_files(doc: Document) -> bool implements IgnoreRule {
    let skip = false;
    if (doc.is_dir() && str_contains(doc.filename(), "scratch_skip")) {
        skip = true;
    }
    if (!doc.is_dir() && str_ends_with(doc.filename(), ".bak.md")) {
        skip = true;
    }
    return skip;
}

let model = onnx_embedder(2048, 12, 42)
    .pooling(Pooling.MEAN)
    .normalize(true)
    .transform_rule("scale_and_norm")
    .emit("onnx_encoder");

assert_true(model.check(), "ONNX model must pass check()");
assert_true(model.opset() >= 18, "ONNX opset must be >= 18");
assert_true(model.output_dim() == 12, "ONNX output_dim must be 12");
assert_true(model.node_count() >= 5, "ONNX graph must have >= 5 nodes");

let toks = int_list().add(11).add(42).add(77);
let tok_emb = model.embed_tokens(toks);
assert_true(tok_emb.len() == 12, "token embedding length must match output_dim");

let tuner = autotuner(25000, 12)
    .metric(Metric.COSINE)
    .max_memory("16MB")
    .max_query_ms(4.0)
    .min_neighbors(8)
    .policy_rule("require_compression");

let cands = tuner.candidate_keys();
assert_true(cands.len() >= 2, "AutoTuner must produce candidate index keys");

let best_plan = tuner.plan().emit("selected_plan");
assert_true(best_plan.compression_ratio() >= 1.2, "selected plan must satisfy IndexPolicy rule");
assert_true(best_plan.nb_clusters() >= 1, "selected plan must report cluster count");

let idx = hnsw_index(12, 16, Metric.COSINE)
    .embedder(model)
    .ef_construction(40)
    .ef_search(32)
    .filter_rule("active_docs_only")
    .rerank_rule("priority_reranker");

idx.add_doc(document(10, "faiss vector index search").field("status", "active").number("priority", 1));
idx.add_doc(document(20, "faiss autofaiss quantization search").field("status", "active").number("priority", 10));
idx.add_doc(document(30, "archived faiss vector index").field("status", "archived").number("priority", 99));

assert_true(idx.ntotal() == 3, "index must hold 3 vectors");

let results = idx.search_text("faiss vector index search", 3).emit("search_results");
assert_true(results.len() == 2, "VectorFilter must filter out archived doc 30");
assert_true(results.at(0).id() == 20, "Reranker must promote high-priority doc 20 to rank 0");

let metrics = idx.evaluate(2).emit("index_metrics");
assert_true(metrics.recall_k_at_k() >= 0.5, "recall_k_at_k must be >= 0.5");

let v1 = synthetic_vector(12, 0, 1, 0.01);
let v2 = synthetic_vector(12, 0, 1, 0.01);
assert_true(l2_distance(v1, v2) < 0.0001, "identical synthetic vectors must have zero L2 distance");
assert_true(cosine_similarity(v1, v2) > 0.999, "identical synthetic vectors must have cosine similarity ~1.0");

# 5. Cached pretrained ONNX model weights + file & directory indexing + search_text
let cached_model = onnx_pretrained("all-MiniLM-L6-v2", "build/test_cache");
assert_true(cached_model.cached(), "pretrained ONNX model must be cached");
assert_true(file_exists(cached_model.cache_path()), "cached model.onnx must exist on disk");

let file_idx = flat_index(cached_model.output_dim(), Metric.COSINE).embedder(cached_model);
let plist = str_list().add("README.md").add("durable-memory");
let indexed_count = file_idx.add_paths(plist);
assert_true(indexed_count >= 2, "add_paths must index README.md and durable-memory/");
let file_hits = file_idx.search_text("ONNX and FAISS vector search", 2);
assert_true(file_hits.len() == 2, "search_text on indexed files must return 2 hits");
assert_true(str_len(file_hits.at(0).path()) > 0, "file hit must record source file path");
assert_true(file_hits.at(0).document().ext() == ".md", "Document.ext() must return .md");
assert_true(file_hits.at(0).document().size() > 10, "Document.size() must be > 10");

# 6. Built-in common filter methods on FaissIndex
file_idx.filter_ext(".md").filter_path_prefix("README").filter_text_contains("lmsearch");
let filtered_hits = file_idx.search_text("ONNX and FAISS vector search", 5);
assert_true(filtered_hits.len() == 1, "filter_path_prefix(README) must narrow results to README.md");
assert_true(filtered_hits.at(0).document().filename() == "README.md", "Document.filename() must be README.md");
file_idx.clear_rules();

# 7. Directory, .gitignore / .lmsearchignore, and @ignore callback pruning
assert_true(git_is_repo("."), "current repository root must be detected by git_is_repo");
assert_true(!git_is_worktree("durable-memory"), "durable-memory directory is not a git worktree");
assert_true(str_len(git_worktree_branch(".")) > 0, "git_worktree_branch(.) must return non-empty branch or HEAD");
assert_true(dir_size_mb(".") >= 0, "dir_size_mb(.) must return non-negative size");
let dir_added = file_idx.add_dir_entry("durable-memory");
assert_true(dir_added == 1, "add_dir_entry must index directory entry");

file_write("build/ign_keep.md", "# Keep this semantic document\nVector search with ONNX and FAISS.\n");
file_write("build/ign_skip.bak.md", "# Backup file that should be ignored by @ignore callback\n");
file_write("build/ign_glob.tmp.md", "# Temp file that should be ignored by ignore_pattern\n");
let ign_idx = flat_index(cached_model.output_dim(), Metric.COSINE)
    .embedder(cached_model)
    .ignore_rule("prune_noise_files")
    .ignore_pattern("*.tmp.md");
assert_true(ign_idx.add_file("build/ign_keep.md") == 1, "ign_keep.md must be indexed");
assert_true(ign_idx.add_file("build/ign_skip.bak.md") == 0, "ign_skip.bak.md must be pruned by @ignore callback");
assert_true(ign_idx.add_file("build/ign_glob.tmp.md") == 0, "ign_glob.tmp.md must be pruned by ignore_pattern");
assert_true(ign_idx.ntotal() == 1, "only 1 non-ignored file must be in ign_idx");
assert_true(ign_idx.search_text("Vector search", 1).at(0).document().in_git(), "Document.in_git() must be true inside git repo");

# 8. Lazy in-memory indexing + cached broad search hits + refined filter memory view
let lazy_idx = flat_index(cached_model.output_dim(), Metric.COSINE)
    .embedder(cached_model)
    .weights_only_cache(true);
assert_true(lazy_idx.add_lazy_path("README.md") == 1, "add_lazy_path(README.md) must register 1 candidate");
assert_true(lazy_idx.add_lazy_path("durable-memory") >= 1, "add_lazy_path(durable-memory) must register candidates");
assert_true(lazy_idx.lazy_embedded_count() == 0, "lazy index must have 0 embedded docs before first query");
let broad_lazy = lazy_idx.lazy_query("ONNX and FAISS vector search", 5);
assert_true(!lazy_idx.last_from_cache(), "first lazy_query must compute embeddings");
assert_true(lazy_idx.last_newly_embedded() >= 2, "first lazy_query must embed candidate files");
assert_true(lazy_idx.cached_hits_count() >= 2, "broad hits must be cached in memory");
assert_true(broad_lazy.len() >= 2, "lazy_query must return broad hits");
lazy_idx.filter_path_prefix("README").filter_text_contains("lmsearch");
let refined_lazy = lazy_idx.refine_view(5);
assert_true(lazy_idx.last_from_cache(), "refine_view must read from memory cache");
assert_true(lazy_idx.last_newly_embedded() == 0, "refine_view must embed 0 new files");
assert_true(refined_lazy.len() == 1, "refine_view must narrow cached hits to README.md");
assert_true(refined_lazy.at(0).document().filename() == "README.md", "refine_view hit must be README.md");

report("status", "all_assertions_passed");
end _lmcode_

mkdir("build");
bin = env("LMSEARCH_BIN", "./build/lmsearch");
r = run_lmcode(program, {command: [bin, "--save-dslb", "build/test.dslb", "--lmcode", "$DSLFILE"]});
assert(r.ok, "test.lms failed");
println(json_stringify(r));
